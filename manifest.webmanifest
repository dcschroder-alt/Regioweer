<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b63ce">
<meta name="application-name" content="Regioweer">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="./icon-512.png">
<link rel="apple-touch-icon" sizes="192x192" href="./icon-192.png">
<link rel="manifest" href="./manifest.webmanifest">
<title>Regioweer Modelmix</title>
<style>
:root {
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #162033;
  background: #eef3f9;
}
* { box-sizing: border-box; }
body { margin: 0; }
.wrap { max-width: 1100px; margin: auto; padding: 14px; }

.hero {
  background: linear-gradient(135deg, #0b63ce, #1593e6);
  color: #fff;
  padding: 16px 20px;
  border-radius: 18px;
  box-shadow: 0 8px 24px #174d7e26;
}
.hero h1 { font-size: 22px; margin: 0 0 4px; }
.hero p { margin: 0; opacity: .9; font-size: 13px; letter-spacing: 0.2px; }

.panel {
  background: #fff;
  border-radius: 18px;
  padding: 16px;
  margin-top: 14px;
  box-shadow: 0 4px 18px #1e355014;
}

/* Location Selector UI */
.loc-search-box {
  position: relative;
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.loc-input-wrap {
  position: relative;
  flex: 1;
}
.loc-input-wrap input {
  width: 100%;
  padding-left: 36px;
}
.search-ico {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #708198;
  font-size: 15px;
  pointer-events: none;
}
.gps-btn {
  background: #edf3fb;
  color: #0b63ce;
  border: 1px solid #cbd6e4;
  padding: 0 16px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  white-space: nowrap;
}
.gps-btn:hover { background: #dbe7f6; }

.geo-results {
  position: absolute;
  top: calc(100% + 5px);
  left: 0;
  right: 0;
  background: #fff;
  border: 1px solid #cbd6e4;
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(20,50,80,0.14);
  max-height: 220px;
  overflow-y: auto;
  z-index: 100;
  display: none;
}
.geo-item {
  padding: 10px 14px;
  cursor: pointer;
  font-size: 13px;
  border-bottom: 1px solid #f0f4f8;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.geo-item:last-child { border-bottom: none; }
.geo-item:hover { background: #f0f6ff; color: #0b63ce; }
.geo-item span.admin { font-size: 11px; color: #718298; }

.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}
.chip {
  background: #f1f5fa;
  color: #3b4d66;
  border: 1px solid #d4dfea;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: all .15s;
}
.chip:hover, .chip.active {
  background: #0b63ce;
  color: #fff;
  border-color: #0b63ce;
}

.cur-loc-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  color: #0b63ce;
  background: #eef6ff;
  border-radius: 8px;
  padding: 4px 8px;
  margin-top: 8px;
}

.coord-toggle { margin-top: 12px; font-size: 12px; }
.coord-toggle summary { color: #64748b; cursor: pointer; font-weight: 600; }
.coord-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 8px;
}

/* Form inputs */
.grid-controls {
  display: grid;
  grid-template-columns: 1.2fr 0.9fr 0.9fr;
  gap: 10px;
  margin-top: 14px;
}
.field { display: flex; flex-direction: column; gap: 5px; }
.field.full { grid-column: 1/-1; }
label { font-size: 12px; font-weight: 700; color: #46566e; }
input, select, button {
  font: inherit;
  border-radius: 12px;
  border: 1px solid #cbd6e4;
  padding: 11px 13px;
  background: #fff;
}
button { border: 0; font-weight: 800; cursor: pointer; transition: background .15s; }
.primary { background: #0b63ce; color: white; }
.primary:hover { background: #094fb0; }
.secondary { background: #19a05b; color: white; }
.secondary:hover { background: #148249; }
.ghost { background: #edf3fb; color: #164f89; }
.ghost:hover { background: #dbe7f6; }
button:disabled { opacity: .4; cursor: not-allowed; }

.buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
.buttons .full { grid-column: 1/-1; }
.status { font-size: 13px; margin-top: 10px; color: #425269; min-height: 20px; }
.bar { height: 6px; border-radius: 999px; background: #e6edf6; overflow: hidden; margin-top: 8px; }
.bar>span { display: block; height: 100%; width: 0; background: #0b63ce; transition: width .25s; }

/* Responsive Adaptive Cards */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 9px;
  margin-top: 14px;
}
.card {
  background: #fff;
  border-radius: 16px;
  padding: 12px 9px;
  text-align: center;
  box-shadow: 0 3px 12px #1e355010;
  border: 1px solid #e8eff7;
  display: flex;
  flex-direction: column;
}
.day-badge {
  font-size: 12px;
  font-weight: 800;
  color: #1a3353;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.date-badge { font-size: 11px; color: #69788d; margin-top: 1px; }
.icon { font-size: 36px; line-height: 1; margin: 8px 0 2px; }
.condition-txt { font-size: 11px; font-weight: 700; color: #3b4e68; min-height: 14px; }
.temps { font-size: 19px; font-weight: 900; margin: 6px 0 8px; }
.temps .max { color: #df4e3a; }
.temps .min { color: #2070c7; }
.temps .sep { color: #cbd5e1; font-weight: 400; margin: 0 1px; }

/* Structured Card Metadata Rows */
.card-meta {
  background: #f8fafc;
  border-radius: 10px;
  padding: 8px 6px;
  font-size: 11px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: left;
  margin-top: auto;
}
.meta-row { display: flex; justify-content: space-between; align-items: center; }
.meta-row span { color: #64748b; }
.meta-row b { color: #1e293b; font-weight: 700; }
.model-pill {
  font-size: 9px;
  color: #8da0b6;
  font-weight: 700;
  margin-top: 6px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

/* SVG Line Chart */
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.chart-title { font-weight: 850; font-size: 16px; color: #1e2b3e; }
.chart-legend { font-size: 11px; font-weight: 700; display: flex; gap: 12px; }
.leg-max { color: #df4e3a; }
.leg-min { color: #2070c7; }
.chart-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }

/* Collapsible Details Panel */
details.panel summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 850;
  font-size: 16px;
  color: #1e2b3e;
}
details.panel summary::-webkit-details-marker { display: none; }
.summary-hint { font-size: 12px; color: #0b63ce; font-weight: 700; }

.runs { display: grid; gap: 7px; margin-top: 12px; }
.runrow {
  display: grid;
  grid-template-columns: 1.1fr .8fr 1.45fr;
  gap: 8px;
  align-items: center;
  padding: 8px 10px;
  background: #f6f9fd;
  border-radius: 12px;
}
.runname { font-weight: 850; font-size: 13px; }
.runcad { font-size: 11px; color: #69798d; }
.runnext { font-size: 12px; text-align: right; color: #34485f; }
.runnext b { color: #0b63ce; }
.runhint { font-size: 10px; color: #7a8798; margin-top: 1px; }

.gfsgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-top: 10px; }
.gfshead, .gfsrow { display: contents; }
.gfscell { padding: 8px 7px; border-bottom: 1px solid #e5ebf2; font-size: 13px; }
.gfshead .gfscell { font-weight: 800; color: #40516a; background: #f4f7fb; }
.gfsactions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
.hidden { display: none !important; }

@media(max-width: 760px) {
  .wrap { padding: 10px; }
  .grid-controls { grid-template-columns: 1fr; }
  .buttons { grid-template-columns: 1fr; }
  .cards { grid-template-columns: repeat(2, 1fr); }
  .runrow { grid-template-columns: 1fr auto; }
  .runcad { grid-column: 1; }
  .runnext { grid-column: 2; grid-row: 1/3; }
  .loc-search-box { flex-direction: column; }
  .gps-btn { justify-content: center; padding: 10px; }
}
</style>
</head>
<body>
<div class="wrap">
  <section class="hero">
    <h1>Regioweer Modelmix</h1>
    <p>KNMI HARMONIE · DWD ICON-D2 · ECMWF · UKMO · ICON-EU · GFS · ARPEGE</p>
  </section>

  <!-- Controls Panel -->
  <section class="panel">
    <!-- Friendly Location Selector -->
    <div class="field full">
      <label>Locatie</label>
      <div class="loc-search-box">
        <div class="loc-input-wrap">
          <span class="search-ico">🔍</span>
          <input id="citySearch" type="text" placeholder="Zoek plaatsnaam (bijv. Utrecht, Houten)..." autocomplete="off">
          <div id="geoResults" class="geo-results"></div>
        </div>
        <button type="button" class="gps-btn" id="gpsBtn">📍 <span>Mijn locatie</span></button>
      </div>

      <div class="presets">
        <button type="button" class="chip" data-lat="52.0907" data-lon="5.1214" data-name="Utrecht (Centraal)">Midden-NL</button>
        <button type="button" class="chip" data-lat="52.3676" data-lon="4.9041" data-name="Amsterdam">Amsterdam</button>
        <button type="button" class="chip" data-lat="51.9244" data-lon="4.4777" data-name="Rotterdam">Rotterdam</button>
        <button type="button" class="chip" data-lat="53.2194" data-lon="6.5665" data-name="Groningen">Groningen</button>
        <button type="button" class="chip" data-lat="51.4416" data-lon="5.4697" data-name="Eindhoven">Eindhoven</button>
        <button type="button" class="chip" data-lat="51.4988" data-lon="3.6109" data-name="Middelburg (Kust)">Zeeland</button>
        <button type="button" class="chip" data-lat="50.8514" data-lon="5.6910" data-name="Maastricht">Limburg</button>
      </div>

      <div>
        <span class="cur-loc-badge" id="locBadge">📍 Houten (52.02° N, 5.17° E)</span>
      </div>

      <details class="coord-toggle">
        <summary>Handmatige coördinaten aanpassen</summary>
        <div class="coord-fields">
          <div class="field"><label>Breedtegraad</label><input id="lat" type="number" step="0.000001" value="52.019260"></div>
          <div class="field"><label>Lengtegraad</label><input id="lon" type="number" step="0.000001" value="5.172830"></div>
        </div>
      </details>
    </div>

    <!-- Model, Days, Run & Date Settings -->
    <div class="grid-controls">
      <div class="field"><label>Model</label>
        <select id="model">
          <option value="mix" selected>Mix modellen (Gewogen ensemble)</option>
          <option value="harmonie">KNMI HARMONIE NL (2 km)</option>
          <option value="icon_d2">DWD ICON-D2 (2.2 km)</option>
          <option value="ecmwf">ECMWF IFS (9 km)</option>
          <option value="ukmo">UK Met Office (10 km)</option>
          <option value="icon_eu">DWD ICON-EU (7 km)</option>
          <option value="gfs">NCEP GFS Global</option>
          <option value="arpege">Météo-France ARPEGE Europe</option>
        </select>
      </div>
      <div class="field"><label>Run (UTC)</label>
        <select id="run"><option>00</option><option>06</option><option>12</option><option>18</option></select>
      </div>
      <div class="field"><label>Aantal dagen</label>
        <select id="days">
          <option value="3">3 dagen</option>
          <option value="5">5 dagen</option>
          <option value="7" selected>7 dagen</option>
          <option value="9">9 dagen</option>
          <option value="10">10 dagen</option>
        </select>
      </div>
      <div class="field full"><label>Datum modelrun</label><input id="date" type="date"></div>
    </div>

    <div class="buttons">
      <button class="primary full" id="load">Gegevens ophalen</button>
      <button class="ghost" id="csv" disabled>Excel / CSV opslaan</button>
      <button class="secondary" id="png" disabled>Website-PNG opslaan</button>
      <button class="secondary full" id="multiPng" disabled>Overzichtsfiguur opslaan</button>
      <button class="ghost full hidden" id="install">📲 App installeren</button>
    </div>

    <div class="bar"><span id="prog"></span></div>
    <div class="status" id="status">Kies instellingen en tik op Gegevens ophalen.</div>
  </section>

  <!-- Temperature Line Graph Panel -->
  <section class="panel hidden" id="chartPanel">
    <div class="chart-header">
      <div class="chart-title">Temperatuurverloop (°C)</div>
      <div class="chart-legend">
        <span class="leg-max">● Max (TX)</span>
        <span class="leg-min">● Min (TN)</span>
      </div>
    </div>
    <div class="chart-wrap" id="chartBox"></div>
  </section>

  <!-- Results Forecast Cards -->
  <section id="results" class="cards"></section>

  <!-- GFS Run TX/TN Table -->
  <section class="panel" id="gfsPanel">
    <div style="font-weight:850;font-size:16px">GFS-run TX / TN</div>
    <div class="note" style="font-size:11px;color:#66758a;margin-top:2px;">Ruwe dagwaarden uit de GFS-uitvoer voor synoptische vergelijking.</div>
    <div id="gfsTable" class="gfsgrid">
      <div class="gfshead"><div class="gfscell">Datum</div><div class="gfscell">TX</div><div class="gfscell">TN</div></div>
    </div>
    <div class="gfsactions">
      <button class="ghost" id="copyTx" disabled>TX kopiëren</button>
      <button class="ghost" id="copyTn" disabled>TN kopiëren</button>
    </div>
  </section>

  <!-- Collapsible Modelruns Schedule -->
  <details class="panel" id="runPanel">
    <summary>
      <span>Modelruns schema</span>
      <span class="summary-hint">Toon / verberg</span>
    </summary>
    <div style="font-size:11px;color:#66758a;margin-top:6px;">Verwachte beschikbaarheid in lokale tijd (UTC tussen haakjes).</div>
    <div id="runSchedule" class="runs"></div>
  </details>

  <section class="panel">
    <div style="font-size:11px;color:#66758a;line-height:1.5;">
      <b>Gewogen Ensemble:</b><br>
      • <b>Dag 1–2 (Korte termijn):</b> Hoge resolutie prioriteit: KNMI HARMONIE (35%), DWD ICON-D2 (30%), ECMWF IFS (20%), UKMO (15%).<br>
      • <b>Dag 3–5 (Middellange termijn):</b> ECMWF IFS (40%), UKMO (25%), ICON-EU (25%), ARPEGE (10%).<br>
      • <b>Dag 6+ (Pluim / Trend):</b> ECMWF IFS (55%), UKMO (30%), GFS (15%).
    </div>
  </section>
</div>

<script>
const $ = id => document.getElementById(id);
const NL = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
let lastRows = [];
let lastGfsRows = [];
let currentLocationName = 'Houten';

// Updated roster of numerical weather prediction models
const MODELS = {
  harmonie: { code: 'knmi_harmonie_arome_netherlands', name: 'KNMI HARMONIE NL (2 km)', hours: 61 },
  icon_d2:  { code: 'dwd_icon_d2', name: 'DWD ICON-D2 (2.2 km)', hours: 49 },
  ecmwf:    { code: 'ecmwf_ifs', name: 'ECMWF IFS (9 km)', hours: 241 },
  ukmo:     { code: 'ukmo_global_10km', fallback: 'ukmo_seamless', name: 'UK Met Office (10 km)', hours: 168 },
  icon_eu:  { code: 'icon_eu', name: 'DWD ICON-EU (7 km)', hours: 121 },
  gfs:      { code: 'gfs_global', fallback: 'gfs_seamless', name: 'NCEP GFS Global', hours: 241 },
  arpege:   { code: 'meteofrance_arpege_europe', name: 'Météo-France ARPEGE', hours: 97 }
};

const RUN_SCHEDULES = [
  { name: 'KNMI HARMONIE', step: 1, delay: [1, 2.5] },
  { name: 'DWD ICON-D2',   step: 3, delay: [1, 2] },
  { name: 'DWD ICON-EU',   step: 3, delay: [1.5, 3] },
  { name: 'UK Met Office', step: 6, delay: [3, 5] },
  { name: 'ARPEGE Europe', step: 6, delay: [2, 4] },
  { name: 'NCEP GFS',      step: 6, delay: [3.5, 5.5] },
  { name: 'ECMWF IFS',     step: 6, delay: [4, 7] }
];

// --- LOCATION HANDLING & PERSISTENCE ---

function setLocation(lat, lon, name = '') {
  $('lat').value = Number(lat).toFixed(6);
  $('lon').value = Number(lon).toFixed(6);
  currentLocationName = name || `${Number(lat).toFixed(2)}°, ${Number(lon).toFixed(2)}°`;
  $('locBadge').textContent = `📍 ${currentLocationName} (${Number(lat).toFixed(2)}° N, ${Number(lon).toFixed(2)}° E)`;
  localStorage.setItem('regioweer_loc', JSON.stringify({ lat: $('lat').value, lon:$('lon').value, name: currentLocationName }));
}

function loadSavedLocation() {
  try {
    const saved = JSON.parse(localStorage.getItem('regioweer_loc'));
    if (saved?.lat && saved?.lon) {
      setLocation(saved.lat, saved.lon, saved.name);
      return;
    }
  } catch (_) {}
  setLocation(52.019260, 5.172830, 'Houten');
}
loadSavedLocation();

$('lat').addEventListener('input', () => setLocation($('lat').value, $('lon').value, 'Aangepast'));$('lon').addEventListener('input', () => setLocation($('lat').value, $('lon').value, 'Aangepast'));

document.querySelectorAll('.presets .chip').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.presets .chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    setLocation(btn.dataset.lat, btn.dataset.lon, btn.dataset.name);
    $('citySearch').value = '';
  });
});

$('gpsBtn').onclick = () => {
  if (!navigator.geolocation) {
    setStatus('Geolocatie wordt niet ondersteund door deze browser.', 0);
    return;
  }
  setStatus('GPS-positie bepalen…', 25);
  navigator.geolocation.getCurrentPosition(
    pos => {
      setLocation(pos.coords.latitude, pos.coords.longitude, 'Mijn GPS-locatie');
      setStatus('GPS-locatie ingesteld.', 100);
      $('load').click();
    },
    err => {
      setStatus(err.code === 1 ? 'Locatietoegang geweigerd.' : 'Kon GPS niet ophalen.', 0);
    },
    { timeout: 10000, enableHighAccuracy: true }
  );
};

let searchDebounce = null;
const searchInput = $('citySearch');
const geoResults = $('geoResults');

searchInput.addEventListener('input', () => {
  clearTimeout(searchDebounce);
  const q = searchInput.value.trim();
  if (q.length < 2) {
    geoResults.style.display = 'none';
    return;
  }
  searchDebounce = setTimeout(async () => {
    try {
      const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(q)}&count=6&language=nl&format=json`);
      const data = await res.json();
      if (!data.results || !data.results.length) {
        geoResults.innerHTML = `<div class="geo-item" style="color:#718298;">Geen locaties gevonden voor "${q}"</div>`;
        geoResults.style.display = 'block';
        return;
      }
      geoResults.innerHTML = data.results.map(item => {
        const admin = [item.admin1, item.country].filter(Boolean).join(', ');
        return `<div class="geo-item" data-lat="${item.latitude}" data-lon="${item.longitude}" data-name="${item.name}">
          <b>${item.name}</b>
          <span class="admin">${admin}</span>
        </div>`;
      }).join('');
      geoResults.style.display = 'block';
    } catch (_) {
      geoResults.style.display = 'none';
    }
  }, 250);
});

geoResults.addEventListener('click', e => {
  const item = e.target.closest('.geo-item');
  if (!item || !item.dataset.lat) return;
  setLocation(item.dataset.lat, item.dataset.lon, item.dataset.name);
  searchInput.value = item.dataset.name;
  geoResults.style.display = 'none';
  document.querySelectorAll('.presets .chip').forEach(c => c.classList.remove('active'));
});

document.addEventListener('click', e => {
  if (!e.target.closest('.loc-input-wrap')) geoResults.style.display = 'none';
});

$('days').addEventListener('change', () => {$('multiPng').textContent = `${$('days').value}-daagse figuur opslaan`;
});

// --- METEOROLOGICAL CALCULATIONS (WIND & BEAUFORT) ---

function degreesToDutchCompass(deg) {
  if (!Number.isFinite(deg)) return '';
  const dirs = ['N', 'NNO', 'NO', 'ONO', 'O', 'OZO', 'ZO', 'ZZO', 'Z', 'ZZW', 'ZW', 'WZW', 'W', 'WNW', 'NW', 'NNW'];
  const idx = Math.round(deg / 22.5) % 16;
  return dirs[idx];
}

// Beaufort scale based strictly on sustained 10m wind speed
function kmhToBeaufort(kmh) {
  if (!Number.isFinite(kmh)) return 0;
  const bftLimits = [1, 5, 11, 19, 28, 38, 49, 61, 74, 88, 102, 117];
  for (let i = 0; i < bftLimits.length; i++) if (kmh <= bftLimits[i]) return i;
  return 12;
}

// Weighted circular vector average for wind direction
function weightedAvgWindDir(itemsWithWeights) {
  let u = 0, v = 0, totalW = 0;
  for (const { item, weight } of itemsWithWeights) {
    if (item?.windDirDeg != null) {
      const rad = item.windDirDeg * Math.PI / 180;
      u += weight * (-Math.sin(rad));
      v += weight * (-Math.cos(rad));
      totalW += weight;
    }
  }
  if (!totalW) return null;
  let deg = Math.atan2(-u, -v) * 180 / Math.PI;
  if (deg < 0) deg += 360;
  return deg;
}

// --- RUN & CYCLE SCHEDULING ---

function initLatestRun() {
  const now = new Date();
  const utcHour = now.getUTCHours();
  let run = '00';
  let d = new Date(now);

  if (utcHour >= 22) run = '18';
  else if (utcHour >= 16) run = '12';
  else if (utcHour >= 10) run = '06';
  else if (utcHour >= 4)  run = '00';
  else {
    d.setUTCDate(d.getUTCDate() - 1);
    run = '18';
  }
  $('date').value = d.toISOString().slice(0, 10);$('run').value = run;
}
initLatestRun();

function nextUtcSlot(step, now = new Date()) {
  const t = now.getTime(), hour = now.getUTCHours();
  const base = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 0, 0, 0, 0);
  let slot = Math.floor(hour / step) * step;
  let candidate = base + slot * 3600000;
  if (candidate <= t) candidate += step * 3600000;
  return new Date(candidate);
}

function hmLocal(d) { return d.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit', hour12: false }); }
function hmUtc(d) { return String(d.getUTCHours()).padStart(2, '0') + ':00 UTC'; }
function countdown(to, now = new Date()) {
  let ms = Math.max(0, to - now), m = Math.ceil(ms / 60000), h = Math.floor(m / 60);
  m %= 60; return h ? `${h}u ${m}m` : `${m} min`;
}

function renderRunSchedule() {
  const box = $('runSchedule'); if (!box) return;
  const now = new Date();
  box.innerHTML = RUN_SCHEDULES.map(r => {
    const n = nextUtcSlot(r.step, now);
    const a = new Date(n.getTime() + r.delay[0] * 3600000);
    const b = new Date(n.getTime() + r.delay[1] * 3600000);
    return `<div class="runrow">
      <div><div class="runname">${r.name}</div><div class="runcad">elke ${r.step === 1 ? '1 uur' : r.step + ' uur'}</div></div>
      <div class="runnext"><b>${hmLocal(n)}</b> (${hmUtc(n)})
        <div class="runhint">over ${countdown(n, now)} · gereed ca. ${hmLocal(a)}–${hmLocal(b)}</div>
      </div>
    </div>`;
  }).join('');
}
renderRunSchedule();
setInterval(renderRunSchedule, 30000);

function runIso() { return `${$('date').value}T${$('run').value}:00`; }

// Fetch model data with automatic fallback to continuous forecast API
async function fetchModel(key) {
  const m = MODELS[key];
  const lat = $('lat').value, lon =$('lon').value;
  const coreVars = 'temperature_2m,precipitation,sunshine_duration,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m,snowfall';
  let rows = null;

  try {
    const url = `https://single-runs-api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&run=${runIso()}&models=${encodeURIComponent(m.code)}&hourly=${encodeURIComponent(coreVars)}&timezone=Europe%2FAmsterdam&forecast_hours=${m.hours}`;
    const res = await fetch(url);
    const data = await res.json();
    if (res.ok && !data.error && data.hourly?.time) {
      rows = hourlyToDaily(data.hourly);
      rows._modelUsed = m;
    }
  } catch (_) {}

  if (!rows) {
    try {
      const modelCode = m.fallback || m.code;
      const fbUrl = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&models=${encodeURIComponent(modelCode)}&hourly=${encodeURIComponent(coreVars)}&timezone=Europe%2FAmsterdam&forecast_days=11`;
      const res = await fetch(fbUrl);
      const data = await res.json();
      if (res.ok && !data.error && data.hourly?.time) {
        rows = hourlyToDaily(data.hourly);
        rows._modelUsed = { ...m, name: m.name + ' (actueel)' };
      }
    } catch (_) {}
  }

  if (!rows) throw new Error(`${m.name} niet beschikbaar`);
  return rows;
}

async function fetchUvData(lat, lon) {
  try {
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&daily=uv_index_max&timezone=Europe%2FAmsterdam&forecast_days=11`);
    const j = await res.json();
    if (j?.daily?.time && j?.daily?.uv_index_max) {
      return Object.fromEntries(j.daily.time.map((d, i) => [d, j.daily.uv_index_max[i]]));
    }
  } catch (e) {
    console.warn('UV fetch fout:', e);
  }
  return {};
}

function hourlyToDaily(h) {
  const map = {};
  for (let i = 0; i < h.time.length; i++) {
    const d = h.time[i].slice(0, 10), hr = h.time[i].slice(11, 13);
    const t = h.temperature_2m?.[i];
    const spd = h.wind_speed_10m?.[i] != null ? +h.wind_speed_10m[i] : null;
    const dir = h.wind_direction_10m?.[i] != null ? +h.wind_direction_10m[i] : null;
    const gst = h.wind_gusts_10m?.[i] != null ? +h.wind_gusts_10m[i] : null;

    if (!map[d]) {
      map[d] = {
        date: d, max: -99, min: 99, precip: 0, sun: 0, snow: 0,
        pop: null, uv: null, windSpeed: 0, windDirDeg: null, gust: 0,
        codes: [], hours: new Set()
      };
    }
    const o = map[d];
    o.hours.add(hr);

    if (t != null) { o.max = Math.max(o.max, +t); o.min = Math.min(o.min, +t); }
    if (h.precipitation?.[i] != null) o.precip += +h.precipitation[i];
    if (h.sunshine_duration?.[i] != null) o.sun += +h.sunshine_duration[i] / 3600;
    if (h.weather_code?.[i] != null) o.codes.push(+h.weather_code[i]);
    if (h.snowfall?.[i] != null) o.snow = (o.snow || 0) + (+h.snowfall[i]);

    if (spd != null && spd >= o.windSpeed) {
      o.windSpeed = spd;
      if (dir != null) o.windDirDeg = dir;
    }
    if (gst != null) o.gust = Math.max(o.gust, gst);
  }
  return Object.values(map)
    .filter(x => x.max > -90)
    .sort((a, b) => a.date.localeCompare(b.date));
}

function localDatePlus(offset) {
  const d = new Date(`${$('date').value}T12:00:00`);
  d.setDate(d.getDate() + offset);
  return d.toLocaleDateString('sv-SE');
}

// --- DYNAMIC MODEL WEIGHTING ENGINE ---

function getModelWeight(modelKey, dayOffset) {
  if (dayOffset <= 2) {
    // Days 1-2: High resolution Dutch/German mesoscale focus
    return {
      harmonie: 3.5, // 2km KNMI
      icon_d2:  3.0, // 2.2km DWD
      ecmwf:    2.0, // 9km global leader
      ukmo:     1.5, // 10km Met Office
      icon_eu:  1.5, // 7km DWD
      arpege:   1.0, // 11km Météo-France
      gfs:      0.8  // Coarser GFS
    }[modelKey] || 1.0;
  } else if (dayOffset <= 5) {
    // Days 3-5: Synoptic medium-range focus
    return {
      ecmwf:    4.0,
      ukmo:     2.5,
      icon_eu:  2.5,
      arpege:   1.5,
      gfs:      1.0
    }[modelKey] || 0;
  } else {
    // Days 6+: Extended trend focus
    return {
      ecmwf:    5.0,
      ukmo:     3.0,
      gfs:      1.5
    }[modelKey] || 0;
  }
}

function weightedAvg(itemsWithWeights, key) {
  let sum = 0, totalW = 0;
  for (const { item, weight } of itemsWithWeights) {
    const val = item?.[key];
    if (Number.isFinite(val)) {
      sum += val * weight;
      totalW += weight;
    }
  }
  return totalW ? sum / totalW : null;
}

function isWinterDate(date) { const m = +date.slice(5, 7); return [11, 12, 1, 2, 3].includes(m); }
function uvLabel(v) {
  if (!Number.isFinite(v)) return '';
  if (v < 3) return 'Laag'; if (v < 6) return 'Matig'; if (v < 8) return 'Hoog'; if (v < 11) return 'Zeer hoog';
  return 'Extreem';
}
function weatherType(r) {
  if (r.precip >= 5) return 'rain';
  if (r.precip >= 0.3) return 'showers';
  if (r.sun >= 6) return 'sun';
  if (r.sun >= 2) return 'partly';
  return 'cloud';
}
function iconFor(t) { return { sun: '☀️', partly: '🌤️', cloud: '☁️', showers: '🌦️', rain: '🌧️' }[t] || '☁️'; }
function conditionText(t) {
  return { sun: 'Zonnig', partly: 'Zon & wolken', cloud: 'Bewolkt', showers: 'Buien', rain: 'Regen' }[t] || 'Bewolkt';
}
function fmt(n, d = 1) { return Number.isFinite(n) ? n.toFixed(d).replace('.', ',') : 'n.b.'; }

function buildWeightedMix(data, numDays) {
  const maps = {};
  for (const [k, v] of Object.entries(data)) maps[k] = Object.fromEntries(v.map(x => [x.date, x]));
  const out = [];

  for (let off = 1; off <= numDays; off++) {
    const date = localDatePlus(off);
    const activeModels = [];

    for (const [k, map] of Object.entries(maps)) {
      const row = map[date];
      if (row) {
        const weight = getModelWeight(k, off);
        if (weight > 0) activeModels.push({ key: k, item: row, weight });
      }
    }

    if (!activeModels.length) continue;

    const totalWeight = activeModels.reduce((acc, curr) => acc + curr.weight, 0);
    const gustVals = activeModels.map(m => m.item.gust).filter(Number.isFinite);
    const snowVals = activeModels.map(m => m.item.snow).filter(Number.isFinite);
    const windDirDeg = weightedAvgWindDir(activeModels);

    // Weighted Probability of Precipitation (PoP >= 0.1mm)
    const rainWeight = activeModels
      .filter(m => m.item.precip >= 0.1)
      .reduce((acc, curr) => acc + curr.weight, 0);
    const pop = totalWeight ? Math.round((rainWeight / totalWeight) * 100) : null;

    const r = {
      date,
      max: weightedAvg(activeModels, 'max'),
      min: weightedAvg(activeModels, 'min'),
      precip: weightedAvg(activeModels, 'precip'),
      sun: weightedAvg(activeModels, 'sun'),
      pop,
      uv: null,
      windSpeed: weightedAvg(activeModels, 'windSpeed'),
      windDirDeg,
      windDir: degreesToDutchCompass(windDirDeg),
      gust: gustVals.length ? Math.max(...gustVals) : null,
      gustChance: gustVals.length ? Math.round((gustVals.filter(v => v >= 75).length / gustVals.length) * 100) : null,
      snow: weightedAvg(activeModels, 'snow'),
      snowChance: snowVals.length ? Math.round((snowVals.filter(v => v > 0.1).length / snowVals.length) * 100) : null,
      count: activeModels.length
    };
    r.type = weatherType(r);
    out.push(r);
  }
  return out;
}

// Responsive SVG Line Chart (TX/TN)
function renderTempChart(rows) {
  const box = $('chartBox');
  if (!rows || rows.length < 2) {
    box.innerHTML = '';
    $('chartPanel').classList.add('hidden');
    return;
  }
  $('chartPanel').classList.remove('hidden');

  const W = Math.max(700, rows.length * 90);
  const H = 210;
  const padL = 40, padR = 30, padT = 30, padB = 35;
  const cW = W - padL - padR;
  const cH = H - padT - padB;

  const maxVals = rows.map(r => r.max).filter(Number.isFinite);
  const minVals = rows.map(r => r.min).filter(Number.isFinite);
  if (!maxVals.length) return;

  const highest = Math.ceil(Math.max(...maxVals) + 1.5);
  const lowest = Math.floor(Math.min(...minVals) - 1.5);
  const range = (highest - lowest) || 1;

  const getX = i => padL + (i / (rows.length - 1)) * cW;
  const getY = temp => padT + ((highest - temp) / range) * cH;

  const maxCoords = rows.map((r, i) => ({ x: getX(i), y: getY(r.max), val: Math.round(r.max) }));
  const minCoords = rows.map((r, i) => ({ x: getX(i), y: getY(r.min), val: Math.round(r.min) }));

  const maxPathD = maxCoords.map((pt, i) => (i === 0 ? `M ${pt.x} ${pt.y}` : `L ${pt.x} ${pt.y}`)).join(' ');
  const minPathD = minCoords.map((pt, i) => (i === 0 ? `M ${pt.x} ${pt.y}` : `L ${pt.x} ${pt.y}`)).join(' ');
  const areaD = maxPathD + ' ' + [...minCoords].reverse().map(pt => `L ${pt.x} ${pt.y}`).join(' ') + ' Z';

  const gridLines = [];
  const step = range > 14 ? 4 : 2;
  const startYVal = Math.ceil(lowest / step) * step;
  for (let v = startYVal; v <= highest; v += step) {
    const yPos = getY(v);
    gridLines.push(`<line x1="${padL - 10}" y1="${yPos}" x2="${W - padR}" y2="${yPos}" stroke="#e8eff7" stroke-width="1"/>
      <text x="${padL - 14}" y="${yPos + 4}" font-size="10" font-weight="600" fill="#94a3b8" text-anchor="end">${v}°</text>`);
  }

  const maxDots = maxCoords.map(pt => `
    <circle cx="${pt.x}" cy="${pt.y}" r="4.5" fill="#df4e3a" stroke="#fff" stroke-width="2"/>
    <text x="${pt.x}" y="${pt.y - 8}" font-size="11" font-weight="850" fill="#df4e3a" text-anchor="middle">${pt.val}°</text>
  `).join('');

  const minDots = minCoords.map(pt => `
    <circle cx="${pt.x}" cy="${pt.y}" r="4.5" fill="#2070c7" stroke="#fff" stroke-width="2"/>
    <text x="${pt.x}" y="${pt.y + 16}" font-size="11" font-weight="850" fill="#2070c7" text-anchor="middle">${pt.val}°</text>
  `).join('');

  const xLabels = rows.map((r, i) => {
    const d = new Date(r.date + 'T12:00:00');
    return `<text x="${getX(i)}" y="${H - 10}" font-size="11" font-weight="700" fill="#475569" text-anchor="middle">${NL[d.getDay()]} ${d.getDate()}</text>`;
  }).join('');

  box.innerHTML = `
    <svg viewBox="0 0 ${W} ${H}" width="100%" height="auto" style="overflow:visible;display:block;">
      ${gridLines.join('')}
      <path d="${areaD}" fill="rgba(11,99,206,0.06)" />
      <path d="${maxPathD}" fill="none" stroke="#df4e3a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="${minPathD}" fill="none" stroke="#2070c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      ${maxDots}
      ${minDots}
      ${xLabels}
    </svg>
  `;
}

function show(rows) {
  const c = $('results'); c.innerHTML = '';
  c.style.gridTemplateColumns = `repeat(auto-fit, minmax(130px, 1fr))`;

  for (const r of rows) {
    const d = new Date(r.date + 'T12:00:00');
    const winter = isWinterDate(r.date);
    const bft = kmhToBeaufort(r.windSpeed);
    const windDirStr = r.windDir ? ` (${r.windDir})` : '';
    const uvTxt = Number.isFinite(r.uv) ? `${fmt(r.uv)} (${uvLabel(r.uv)})` : 'n.b.';

    let snowRow = '';
    if (winter && Number.isFinite(r.snowChance)) {
      snowRow = `<div class="meta-row"><span>❄ Sneeuw</span><b>${r.snowChance}%</b></div>`;
    }

    c.insertAdjacentHTML('beforeend', `
      <article class="card">
        <div class="day-badge">${NL[d.getDay()]} ${d.getDate()}</div>
        <div class="date-badge">${d.toLocaleDateString('nl-NL', { month: 'short' })}</div>
        <div class="icon">${iconFor(r.type)}</div>
        <div class="condition-txt">${conditionText(r.type)}</div>
        <div class="temps">
          <span class="max">${Math.round(r.max)}°</span><span class="sep">/</span><span class="min">${Math.round(r.min)}°</span>
        </div>
        <div class="card-meta">
          <div class="meta-row"><span>☀ Zon</span><b>${fmt(r.sun)} u</b></div>
          <div class="meta-row"><span>💧 Regen</span><b>${fmt(r.precip)} mm</b></div>
          <div class="meta-row"><span>☂ Neerslag</span><b>${Number.isFinite(r.pop) ? Math.round(r.pop) + '%' : 'n.b.'}</b></div>
          <div class="meta-row"><span>☀️ UV-index</span><b>${uvTxt}</b></div>
          <div class="meta-row"><span>💨 Wind</span><b>${bft} Bft${windDirStr}</b></div>
          <div class="meta-row"><span>🌪 Windstoot</span><b>${Number.isFinite(r.gust) ? Math.round(r.gust) + ' km/u' : 'n.b.'}</b></div>
          ${snowRow}
        </div>
        ${r.count > 1 ? `<div class="model-pill">${r.count} modellen</div>` : ''}
      </article>`);
  }
}

function setStatus(t, p) { $('status').textContent = t; $('prog').style.width = `${p}%`; }

function renderGfs(rows) {
  const t = $('gfsTable');
  t.innerHTML = '<div class="gfshead"><div class="gfscell">Datum</div><div class="gfscell">TX</div><div class="gfscell">TN</div></div>';
  for (const r of rows.slice(0, 10)) {
    const d = new Date(r.date + 'T12:00:00');
    t.insertAdjacentHTML('beforeend', `<div class="gfsrow"><div class="gfscell">${d.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit' })}</div><div class="gfscell"><b>${fmt(r.max)}°</b></div><div class="gfscell">${fmt(r.min)}°</div></div>`);
  }
  $('copyTx').disabled =$('copyTn').disabled = !rows.length;
}

$('copyTx').onclick = () => copyClipboard(lastGfsRows.map(r => fmt(r.max)).join('\n'), 'TX gekopieerd.');$('copyTn').onclick = () => copyClipboard(lastGfsRows.map(r => fmt(r.min)).join('\n'), 'TN gekopieerd.');

async function copyClipboard(text, msg) {
  try {
    await navigator.clipboard.writeText(text);
    setStatus(msg, 100);
  } catch (_) {
    setStatus('Kopiëren niet toegestaan door browser.', 100);
  }
}

$('load').onclick = async () => {
  lastRows = []; lastGfsRows = []; renderGfs([]);
  ['csv', 'png', 'multiPng'].forEach(id => $(id).disabled = true);$('chartPanel').classList.add('hidden');

  try {
    setStatus('Modeldata parallel opvragen…', 20);
    const selectedModel = $('model').value;
    const numDays = parseInt($('days').value, 10) || 7;
    const lat = $('lat').value, lon =$('lon').value;

    const uvPromise = fetchUvData(lat, lon);

    if (selectedModel === 'mix') {
      const order = ['harmonie', 'icon_d2', 'ecmwf', 'ukmo', 'icon_eu', 'gfs', 'arpege'];
      const data = {};

      const results = await Promise.allSettled(order.map(async k => {
        const rows = await fetchModel(k);
        return { key: k, rows };
      }));

      results.forEach(res => {
        if (res.status === 'fulfilled') data[res.value.key] = res.value.rows;
      });

      if (data.gfs) {
        lastGfsRows = data.gfs.filter(r => r.date >= $('date').value).slice(0, 10);
      } else {
        try {
          const directGfs = await fetchModel('gfs');
          lastGfsRows = directGfs.filter(r => r.date >= $('date').value).slice(0, 10);
        } catch (_) {}
      }
      renderGfs(lastGfsRows);

      lastRows = buildWeightedMix(data, numDays);
      if (lastRows.length < 2) throw new Error('Onvoldoende modeldata voor deze run.');

    } else {
      const rows = await fetchModel(selectedModel);
      const base = $('date').value;
      lastRows = rows.filter(r => selectedModel === 'gfs' ? r.date >= base : r.date > base).slice(0, numDays).map(r => ({
        ...r, count: 1, pop: null,
        windDir: degreesToDutchCompass(r.windDirDeg),
        gustChance: Number.isFinite(r.gust) ? (r.gust >= 75 ? 100 : 0) : null,
        snowChance: Number.isFinite(r.snow) ? (r.snow > 0.1 ? 100 : 0) : null,
        type: weatherType(r)
      }));

      if (selectedModel === 'gfs') {
        lastGfsRows = rows.filter(r => r.date >= base).slice(0, 10);
        renderGfs(lastGfsRows);
      }
    }

    const uvMap = await uvPromise;
    for (const r of lastRows) {
      if (uvMap[r.date] != null) r.uv = uvMap[r.date];
    }

    show(lastRows);
    renderTempChart(lastRows);

    $('multiPng').textContent = `${lastRows.length}-daagse figuur opslaan`;
    ['csv', 'png', 'multiPng'].forEach(id => $(id).disabled = false);
    setStatus(`Gereed voor ${currentLocationName} – ${lastRows.length} dagen berekend.`, 100);

  } catch (e) {
    setStatus('Fout: ' + e.message, 0);
  }
};

function download(blob, name) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.append(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
}

$('csv').onclick = () => {
  const lines = ['Datum;TX (°C);TN (°C);Zon (uur);Neerslag (mm);Neerslagkans (%);UV-index;Wind (Bft);Windrichting;Windstoot (km/u);Kans zware windstoten (>=75 km/u);Sneeuwkans (%);Modellen'];
  for (const r of lastRows) {
    lines.push([
      r.date, fmt(r.max), fmt(r.min), fmt(r.sun), fmt(r.precip),
      Number.isFinite(r.pop) ? Math.round(r.pop) : '',
      fmt(r.uv),
      kmhToBeaufort(r.windSpeed),
      r.windDir || '',
      Number.isFinite(r.gust) ? Math.round(r.gust) : '',
      Number.isFinite(r.gustChance) ? r.gustChance : '',
      isWinterDate(r.date) && Number.isFinite(r.snowChance) ? r.snowChance : '',
      r.count
    ].join(';'));
  }
  download(new Blob(['\ufeff' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' }), `regioweer-${currentLocationName.toLowerCase().replace(/[^a-z0-9]/g,'_')}-${$('date').value}.csv`);
};

function drawWeather(ctx, t, cx, cy) {
  ctx.save(); ctx.lineWidth = 3; ctx.lineCap = 'round';
  function sun(x, y, r) {
    ctx.strokeStyle = '#f3a712'; ctx.fillStyle = '#ffd54a';
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    for (let a = 0; a < 8; a++) {
      const q = a * Math.PI / 4;
      ctx.beginPath();
      ctx.moveTo(x + Math.cos(q) * (r + 5), y + Math.sin(q) * (r + 5));
      ctx.lineTo(x + Math.cos(q) * (r + 12), y + Math.sin(q) * (r + 12));
      ctx.stroke();
    }
  }
  function cloud(x, y) {
    ctx.fillStyle = '#d7e0e8'; ctx.strokeStyle = '#91a1b2';
    ctx.beginPath();
    ctx.arc(x - 18, y, 15, Math.PI, 0); ctx.arc(x, y - 11, 20, Math.PI, 0); ctx.arc(x + 22, y, 14, Math.PI, 0);
    ctx.lineTo(x + 34, y + 13); ctx.lineTo(x - 30, y + 13);
    ctx.closePath(); ctx.fill(); ctx.stroke();
  }
  if (t === 'sun') sun(cx, cy, 22);
  else if (t === 'partly') { sun(cx - 14, cy - 13, 17); cloud(cx + 5, cy + 5); }
  else {
    cloud(cx, cy - 3);
    if (t === 'showers' || t === 'rain') {
      ctx.strokeStyle = '#287dcc';
      for (let x = -18; x <= 18; x += 18) {
        ctx.beginPath();
        ctx.moveTo(cx + x, cy + 20);
        ctx.lineTo(cx + x - 4, cy + 31 + (t === 'rain' ? 5 : 0));
        ctx.stroke();
      }
    }
  }
  ctx.restore();
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

$('png').onclick = () => {
  const n = lastRows.length;
  const W = Math.max(1500, n * 170);
  const H = 500, c = document.createElement('canvas');
  c.width = W; c.height = H; const x = c.getContext('2d');
  x.fillStyle = '#f7fbff'; x.fillRect(0, 0, W, H);
  x.fillStyle = '#0b63ce'; x.fillRect(0, 0, W, 72);
  x.fillStyle = 'white'; x.font = '700 31px Arial';
  x.fillText(`Regioweer – ${currentLocationName}`, 32, 45);

  const cw = (W - 40) / n;
  for (let i = 0; i < n; i++) {
    const r = lastRows[i], left = 20 + i * cw, mid = left + cw / 2, d = new Date(r.date + 'T12:00:00');
    const bft = kmhToBeaufort(r.windSpeed);
    if (i) { x.strokeStyle = '#d7e2ee'; x.beginPath(); x.moveTo(left, 88); x.lineTo(left, H - 24); x.stroke(); }
    x.textAlign = 'center'; x.fillStyle = '#23344a'; x.font = '700 20px Arial';
    x.fillText(NL[d.getDay()].toUpperCase(), mid, 112);
    x.font = '16px Arial'; x.fillStyle = '#63748a';
    x.fillText(d.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit' }), mid, 137);
    
    drawWeather(x, r.type, mid, 190);
    
    x.font = '700 28px Arial'; x.fillStyle = '#df4e3a';
    x.fillText(`${Math.round(r.max)}°`, mid - 27, 273);
    x.fillStyle = '#2070c7';
    x.fillText(`${Math.round(r.min)}°`, mid + 28, 273);
    x.font = '15px Arial'; x.fillStyle = '#394c63';
    x.fillText(`☀ ${fmt(r.sun)} u · 💧 ${fmt(r.precip)} mm`, mid, 322);
    x.fillText(`💨 ${bft} Bft ${r.windDir || ''}`, mid, 350);
    x.font = '13px Arial'; x.fillStyle = '#718096';
    if (r.count > 1) x.fillText(`${r.count} modellen`, mid, 386);
  }
  x.textAlign = 'left'; x.font = '13px Arial'; x.fillStyle = '#718096';
  x.fillText(`Run ${$('date').value} ${$('run').value} UTC · ${currentLocationName} · KNMI HARMONIE, ICON-D2, ECMWF, UKMO, ICON-EU, GFS, ARPEGE`, 24, 474);
  c.toBlob(b => download(b, `regioweer-${$('date').value}.png`), 'image/png');
};

$('multiPng').onclick = () => {
  const rows = lastRows;
  if (!rows.length) return;
  const n = rows.length;
  const W = Math.max(1500, n * 240);
  const H = 900, c = document.createElement('canvas');
  c.width = W; c.height = H; const x = c.getContext('2d');

  const grad = x.createLinearGradient(0, 0, W, 0);
  grad.addColorStop(0, '#0664c8'); grad.addColorStop(1, '#4c91df');
  x.fillStyle = grad; roundRect(x, 0, 0, W, 112, 0); x.fill();

  x.fillStyle = '#fff'; x.textAlign = 'left'; x.font = '700 40px Arial';
  x.fillText(`Regioweer – ${currentLocationName}`, 42, 50);
  x.font = '700 26px Arial'; x.fillStyle = '#d6e8ff';
  x.fillText(`${n}-daagse modelverwachting`, 42, 88);
  x.textAlign = 'right'; x.font = '22px Arial'; x.fillStyle = '#fff';
  x.fillText('Gewogen modelensemble · Nederland', W - 40, 68);

  const pad = 20, gap = 10, cw = (W - pad * 2 - gap * (n - 1)) / n, top = 130, ch = 690;
  for (let i = 0; i < n; i++) {
    const r = rows[i], left = pad + i * (cw + gap), mid = left + cw / 2, d = new Date(r.date + 'T12:00:00'), winter = isWinterDate(r.date);
    x.fillStyle = '#f8fbff'; x.shadowColor = 'rgba(20,50,80,.12)'; x.shadowBlur = 10; x.shadowOffsetY = 3;
    roundRect(x, left, top, cw, ch, 18); x.fill(); x.shadowColor = 'transparent';

    x.textAlign = 'center'; x.fillStyle = '#10274d'; x.font = '700 25px Arial';
    x.fillText(`${NL[d.getDay()].toUpperCase()} ${d.toLocaleDateString('nl-NL', { day: '2-digit', month: 'short' })}`, mid, 174);
    
    drawWeather(x, r.type, mid, 252);

    x.font = '700 16px Arial'; x.fillStyle = '#23364f';
    x.fillText(conditionText(r.type), mid, 315);

    x.font = '700 38px Arial'; x.fillStyle = '#d81d2c';
    x.fillText(`${Math.round(r.max)}°`, mid - 40, 378);
    x.fillStyle = '#1267cc';
    x.fillText(`${Math.round(r.min)}°`, mid + 40, 378);
    x.font = '13px Arial'; x.fillStyle = '#6e7f94';
    x.fillText('Max', mid - 40, 402); x.fillText('Min', mid + 40, 402);

    const bft = kmhToBeaufort(r.windSpeed);
    const windStr = `${bft} Bft ${r.windDir ? '(' + r.windDir + ')' : ''}`;
    const uvText = Number.isFinite(r.uv) ? `${fmt(r.uv)} · ${uvLabel(r.uv)}` : 'n.b.';

    const lines = [
      ['☀', 'Zonuren', `${fmt(r.sun)} u`],
      ['💧', 'Neerslag', `${fmt(r.precip)} mm`],
      ['☂', 'Kans op neerslag', Number.isFinite(r.pop) ? `${Math.round(r.pop)}%` : 'n.b.'],
      ['UV', 'UV-index', uvText],
      ['💨', 'Windkracht', windStr],
      ['🌪', 'Max. windstoot', Number.isFinite(r.gust) ? `${Math.round(r.gust)} km/u` : 'n.b.'],
      ['⚠', 'Kans zware stoten', Number.isFinite(r.gustChance) ? `${r.gustChance}%` : 'n.b.']
    ];
    if (winter) lines.splice(3, 0, ['❄', 'Sneeuwkans', Number.isFinite(r.snowChance) ? `${r.snowChance}%` : 'n.b.']);

    let y = 448;
    for (const [ico, label, val] of lines) {
      x.textAlign = 'left'; x.font = '17px Arial'; x.fillStyle = '#116bd0';
      x.fillText(ico, left + 14, y);
      x.font = '14px Arial'; x.fillStyle = '#21364f';
      x.fillText(label, left + 42, y);
      x.textAlign = 'right'; x.font = '700 14px Arial'; x.fillStyle = '#142b4e';
      x.fillText(val, left + cw - 12, y);
      x.strokeStyle = '#dce7f3'; x.beginPath();
      x.moveTo(left + 12, y + 12); x.lineTo(left + cw - 12, y + 12); x.stroke();
      y += 48;
    }
  }

  x.textAlign = 'left'; x.font = '14px Arial'; x.fillStyle = '#5f7186';
  x.fillText(`Run ${$('date').value} ${$('run').value} UTC · ${currentLocationName} (${$('lat').value} N, ${$('lon').value} E)`, 28, 862);
  x.textAlign = 'right';
  x.fillText('KNMI HARMONIE · ICON-D2 · ECMWF · UKMO · ICON-EU · GFS · ARPEGE', W - 28, 862);
  c.toBlob(b => download(b, `regioweer-${n}-daagse-${$('date').value}.png`), 'image/png');
};

let deferredInstall = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferredInstall = e; $('install').classList.remove('hidden'); });$('install').onclick = async () => { if (!deferredInstall) return; deferredInstall.prompt(); await deferredInstall.userChoice; deferredInstall = null; $('install').classList.add('hidden'); };
window.addEventListener('appinstalled', () => { $('install').classList.add('hidden'); setStatus('Regioweer geïnstalleerd.', 100); });
if ('serviceWorker' in navigator) { window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js', { scope: './' }).catch(console.error)); }
</script>
</body>
</html>